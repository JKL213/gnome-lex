using Gtk 4.0;
using Adw 1;

template $LexWindow : Adw.ApplicationWindow {
  title: _("Gesetze");
  default-width: 1100;
  default-height: 720;
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint breakpoint {
    condition ("max-width: 640sp")

    setters {
      split_view.collapsed: true;
      notes_split.collapsed: true;
      jump_bar.compact: true;
      split_button.visible: false;
      history_button.visible: false;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Stack stack {
      transition-type: crossfade;

      StackPage {
        name: "empty";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [end]
            MenuButton {
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Hauptmenü");
              primary: true;
              menu-model: primary_menu;
            }
          }

          content: Adw.StatusPage empty_page {
            icon-name: "org.gnomelex.Gesetze";
            title: _("Kein Gesetz geladen");
            description: _("Gesetze werden einmalig von gesetze-im-internet.de heruntergeladen und lokal gespeichert.");

            // Eine Schaltfläche je bekannter Quelle (wird im Code befüllt).
            child: Box download_buttons {
              orientation: vertical;
              spacing: 12;
              halign: center;
            };
          };
        };
      }

      StackPage {
        name: "busy";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [end]
            MenuButton {
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Hauptmenü");
              menu-model: primary_menu;
            }
          }

          content: Adw.StatusPage busy_page {
            title: _("Lade herunter …");
            description: "";
          };
        };
      }

      StackPage {
        name: "law";

        child: Adw.NavigationSplitView split_view {
          min-sidebar-width: 240;
          max-sidebar-width: 420;
          sidebar-width-fraction: 0.3;

          sidebar: Adw.NavigationPage {
            title: _("Gliederung");
            tag: "sidebar";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                // Auswahl des Gesetzes, dessen Gliederung gezeigt wird.
                title-widget: DropDown law_dropdown {
                  tooltip-text: _("Gesetz der Gliederung");
                };

                [end]
                MenuButton {
                  icon-name: "open-menu-symbolic";
                  tooltip-text: _("Hauptmenü");
                  primary: true;
                  menu-model: primary_menu;
                }
              }

              content: Adw.ViewStack sidebar_stack {
                Adw.ViewStackPage {
                  name: "outline";
                  title: _("Gliederung");
                  icon-name: "view-list-symbolic";

                  child: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: ListView outline_view {
                      single-click-activate: true;

                      styles ["navigation-sidebar"]
                    };
                  };
                }

                Adw.ViewStackPage {
                  name: "favorites";
                  title: _("Favoriten");
                  icon-name: "starred-symbolic";

                  child: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: ListBox favorites_list {
                      selection-mode: none;

                      styles ["navigation-sidebar"]
                    };
                  };
                }
              };

              [bottom]
              Adw.ViewSwitcherBar {
                stack: sidebar_stack;
                reveal: true;
              }
            };
          };

          content: Adw.NavigationPage content_page {
            title: _("Norm");
            tag: "content";

            // Rechts einblendbares Panel für die eigene Notiz (Schema) zur Norm.
            child: Adw.OverlaySplitView notes_split {
              sidebar-position: end;
              show-sidebar: false;
              min-sidebar-width: 260;
              max-sidebar-width: 440;
              sidebar-width-fraction: 0.32;

              sidebar: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                  show-start-title-buttons: false;
                  show-end-title-buttons: false;

                  title-widget: Adw.WindowTitle notes_title {
                    title: _("Schema / Notiz");
                    subtitle: "";
                  };

                  [end]
                  Button {
                    icon-name: "window-close-symbolic";
                    tooltip-text: _("Panel schließen");
                    action-name: "win.toggle-notes";
                  }
                }

                content: ScrolledWindow {
                  hscrollbar-policy: never;
                  vexpand: true;

                  child: TextView notes_view {
                    wrap-mode: word_char;
                    accepts-tab: false;
                    top-margin: 8;
                    bottom-margin: 8;
                    left-margin: 8;
                    right-margin: 8;

                    styles ["notes-view"]
                  };
                };

                [bottom]
                Label notes_hint {
                  label: _("Wird automatisch gespeichert und unter der Überschrift der Norm angezeigt.");
                  wrap: true;
                  margin-top: 6;
                  margin-bottom: 8;
                  margin-start: 12;
                  margin-end: 12;

                  styles ["dim-label", "caption"]
                }
              };

              content: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                  [start]
                  Box {
                    styles ["linked"]

                    Button {
                      icon-name: "go-previous-symbolic";
                      tooltip-text: _("Vorherige Norm (Alt+Bild↑)");
                      action-name: "win.prev-norm";
                    }

                    Button {
                      icon-name: "go-next-symbolic";
                      tooltip-text: _("Nächste Norm (Alt+Bild↓)");
                      action-name: "win.next-norm";
                    }
                  }

                  [start]
                  MenuButton history_button {
                    icon-name: "document-open-recent-symbolic";
                    tooltip-text: _("Zuletzt gelesene Normen");

                    popover: Popover history_popover {
                      child: Box {
                        orientation: vertical;
                        spacing: 6;
                        width-request: 320;

                        ScrolledWindow {
                          hscrollbar-policy: never;
                          propagate-natural-height: true;
                          max-content-height: 420;

                          child: ListBox history_list {
                            selection-mode: none;

                            styles ["navigation-sidebar"]
                          };
                        }

                        Button {
                          label: _("Verlauf leeren");
                          action-name: "win.clear-history";
                          halign: end;
                          margin-end: 6;
                          margin-bottom: 6;

                          styles ["flat"]
                        }
                      };
                    };
                  }

                  title-widget: $LexJumpBar jump_bar {
                    margin-start: 6;
                    margin-end: 6;
                  };

                  [end]
                  MenuButton {
                    icon-name: "open-menu-symbolic";
                    tooltip-text: _("Hauptmenü");
                    menu-model: primary_menu;
                    visible: bind split_view.collapsed;
                  }

                  [end]
                  ToggleButton favorite_button {
                    icon-name: "non-starred-symbolic";
                    tooltip-text: _("Favorit (Strg+D)");
                    action-name: "win.toggle-favorite";
                  }

                  [end]
                  ToggleButton notes_button {
                    icon-name: "document-edit-symbolic";
                    tooltip-text: _("Schema / Notiz (Strg+Umschalt+N)");
                    action-name: "win.toggle-notes";
                  }

                  [end]
                  ToggleButton split_button {
                    icon-name: "view-dual-symbolic";
                    tooltip-text: _("Geteilte Ansicht (Strg+Umschalt+D)");
                    action-name: "win.split";
                  }

                }

                content: $LexReader reader {};
              };
            };
          };
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Springen …");
      action: "win.quick-search";
    }
    item {
      label: _("_Geteilte Ansicht");
      action: "win.split";
    }
    item {
      label: _("_Favorit");
      action: "win.toggle-favorite";
    }
    item {
      label: _("Schema / _Notiz");
      action: "win.toggle-notes";
    }
  }
  section {
    item {
      label: _("Schrift ver_größern");
      action: "win.zoom-in";
    }
    item {
      label: _("Schrift ver_kleinern");
      action: "win.zoom-out";
    }
    item {
      label: _("Schriftgröße _zurücksetzen");
      action: "win.zoom-reset";
    }
  }
  section {
    item {
      label: _("Auf _Aktualisierung prüfen");
      action: "win.check-updates";
    }
    item {
      label: _("Gesetze _herunterladen …");
      action: "win.download-center";
    }
  }
  section {
    item {
      label: _("_Einstellungen");
      action: "app.preferences";
    }
    item {
      label: _("_Tastenkürzel");
      action: "app.shortcuts";
    }
    item {
      label: _("_Info zu Gesetze");
      action: "app.about";
    }
    item {
      label: _("_Beenden");
      action: "app.quit";
    }
  }
}
