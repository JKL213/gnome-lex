using Gtk 4.0;
using Adw 1;

template $LexWindow : Adw.ApplicationWindow {
  title: _("Gesetze");
  default-width: 1100;
  default-height: 720;
  width-request: 360;
  height-request: 294;

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        [end]
        MenuButton {
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Hauptmenü");
          primary: true;
          menu-model: primary_menu;
        }
      }

      content: Stack stack {
        transition-type: crossfade;

        StackPage {
          name: "empty";
          child: Adw.StatusPage empty_page {
            icon-name: "org.gnomelex.Gesetze";
            title: _("Kein Gesetz geladen");
            description: _("Das Bürgerliche Gesetzbuch wird einmalig von gesetze-im-internet.de heruntergeladen und lokal gespeichert.");

            child: Button download_button {
              label: _("BGB herunterladen");
              halign: center;
              action-name: "win.download";

              styles ["pill", "suggested-action"]
            };
          };
        }

        StackPage {
          name: "busy";
          child: Adw.StatusPage busy_page {
            title: _("Lade herunter …");
            description: "";
          };
        }

        StackPage {
          name: "ready";
          child: Adw.StatusPage ready_page {
            icon-name: "org.gnomelex.Gesetze";
            title: _("Bürgerliches Gesetzbuch");
            description: "";

            child: Box {
              orientation: vertical;
              spacing: 12;
              halign: center;

              Label version_label {
                wrap: true;
                justify: center;

                styles ["dim-label"]
              }

              Button {
                label: _("Auf Aktualisierung prüfen");
                halign: center;
                action-name: "win.check-updates";

                styles ["pill"]
              }
            };
          };
        }
      };
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("Auf _Aktualisierung prüfen");
      action: "win.check-updates";
    }
    item {
      label: _("BGB neu _herunterladen");
      action: "win.download";
    }
  }
  section {
    item {
      label: _("_Info zu Gesetze");
      action: "app.about";
    }
    item {
      label: _("_Beenden");
      action: "app.quit";
    }
  }
}
