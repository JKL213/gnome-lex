using Gtk 4.0;
using Adw 1;

// Anzeige einer einzelnen Norm als formatierter Text.
template $LexNormView : Adw.Bin {
  child: ScrolledWindow scrolled {
    hscrollbar-policy: never;
    vexpand: true;

    child: Adw.ClampScrollable {
      maximum-size: 780;
      tightening-threshold: 620;

      child: TextView text_view {
        // Editierbar, damit Tastatureingaben ankommen; der Normtext ist über das
        // Tag „base“ (editable = false) gesperrt, nur Notizblöcke sind frei.
        editable: true;
        cursor-visible: false;
        wrap-mode: word_char;
        // Satzbild wie in den gedruckten Textsammlungen: Blocksatz mit
        // Erstzeileneinzug, enger Zeilenfall. Links steht die Randspalte
        // mit den Hinweispfeilen (Gutter), daher der kleinere Rand.
        justification: fill;
        indent: 18;
        left-margin: 12;
        right-margin: 32;
        top-margin: 24;
        bottom-margin: 64;
        pixels-above-lines: 1;
        pixels-below-lines: 5;
        pixels-inside-wrap: 2;

        styles ["norm-text"]
      };
    };
  };
}
