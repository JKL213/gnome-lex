{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flatpak: Gesetze debuggen (neu bauen)",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "flatpak: build",
      "program": "/app/bin/gesetze",
      "cwd": "/app",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "pipeTransport": {
        "pipeCwd": "${workspaceFolder}",
        "pipeProgram": "${workspaceFolder}/build-aux/flatpak-run.sh",
        "pipeArgs": [],
        "debuggerPath": "gdb"
      },
      "sourceFileMap": {
        "/run/build/gesetze": "${workspaceFolder}"
      },
      "environment": [
        { "name": "RUST_BACKTRACE", "value": "1" },
        { "name": "G_MESSAGES_DEBUG", "value": "all" },
        { "name": "GTK_DEBUG", "value": "interactive" }
      ],
      "setupCommands": [
        { "description": "Debug-Symbole des Flatpak-Builds", "text": "set debug-file-directory /app/lib/debug:/usr/lib/debug", "ignoreFailures": false },
        { "description": "Pretty-Printing", "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "description": "Rust-Pretty-Printer aus dem SDK", "text": "python import sys; sys.path.insert(0, '/usr/lib/sdk/rust-stable/lib/rustlib/etc'); import gdb_lookup; gdb_lookup.register_printers(gdb.current_objfile())", "ignoreFailures": true },
        { "description": "Breakpoints vor dem Laden erlauben", "text": "set breakpoint pending on", "ignoreFailures": true },
        { "description": "Rust-Panics anhalten", "text": "break rust_panic", "ignoreFailures": true }
      ],
      "logging": { "engineLogging": false }
    },
    {
      "name": "Flatpak: Gesetze debuggen (ohne Neubau)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/app/bin/gesetze",
      "cwd": "/app",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "pipeTransport": {
        "pipeCwd": "${workspaceFolder}",
        "pipeProgram": "${workspaceFolder}/build-aux/flatpak-run.sh",
        "pipeArgs": [],
        "debuggerPath": "gdb"
      },
      "sourceFileMap": {
        "/run/build/gesetze": "${workspaceFolder}"
      },
      "environment": [
        { "name": "RUST_BACKTRACE", "value": "1" },
        { "name": "G_MESSAGES_DEBUG", "value": "all" }
      ],
      "setupCommands": [
        { "text": "set debug-file-directory /app/lib/debug:/usr/lib/debug" },
        { "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "text": "python import sys; sys.path.insert(0, '/usr/lib/sdk/rust-stable/lib/rustlib/etc'); import gdb_lookup; gdb_lookup.register_printers(gdb.current_objfile())", "ignoreFailures": true },
        { "text": "set breakpoint pending on", "ignoreFailures": true },
        { "text": "break rust_panic", "ignoreFailures": true }
      ]
    },
    {
      "name": "Nativ: Gesetze debuggen (cargo)",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "cargo build",
      "program": "${workspaceFolder}/target/debug/gesetze",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "externalConsole": false,
      "environment": [
        { "name": "RUST_BACKTRACE", "value": "1" },
        { "name": "G_MESSAGES_DEBUG", "value": "all" }
      ],
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "text": "set breakpoint pending on", "ignoreFailures": true },
        { "text": "break rust_panic", "ignoreFailures": true }
      ]
    }
  ]
}
